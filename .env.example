# Public Supabase project settings used by the configured demo project.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only access required for live dashboards, leave workflows, and support.
# Never prefix this key with NEXT_PUBLIC_ or expose it in client components.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Use a long random value outside local development. Never commit the real value.
DEMO_SESSION_SECRET=replace-with-at-least-32-random-characters
