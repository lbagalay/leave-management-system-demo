# Public Supabase project settings. The app remains usable in demo-auth mode
# when these are left blank.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional server-side dashboard data access for the demo-auth foundation.
# Never prefix this key with NEXT_PUBLIC_ or expose it in client components.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Use a long random value outside local development. Never commit the real value.
DEMO_SESSION_SECRET=replace-with-at-least-32-random-characters
